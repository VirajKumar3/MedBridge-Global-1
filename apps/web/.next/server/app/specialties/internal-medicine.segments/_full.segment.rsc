10:["$","main",null,{"className":"min-h-screen bg-white text-[#080808] flex flex-col selection:bg-neutral-200","children":[["$","$L23",null,{}],["$","$L24",null,{"specialty":{"id":"internal-medicine","name":"Internal Medicine","label":"INTERNAL MEDICINE","shortIntro":"Comprehensive adult healthcare coordinating preventive diagnosis, complex chronic disease management, and long-term wellness.","heroImage":"/images/specialty-hero-internal-medicine.webp","heroAlt":"Female physician consulting with an adult patient in a modern clinical room","conditionsSubtitle":"Targeted diagnosis and ongoing management for acute and chronic adult health conditions.","conditions":[{"name":"Diabetes & Metabolic Health","description":"Personalized glycemic balance, insulin therapy, and continuous glucose tracking.","image":"/images/condition-diabetes.webp"},{"name":"Heart & Vascular Health","description":"Blood pressure stabilization, arterial assessment, and preventive cardiovascular care.","image":"/images/condition-cardio.webp"},{"name":"Thyroid & Hormone Balance","description":"Comprehensive endocrine panels for Hashimoto's, hypothyroidism, and adrenal wellness.","image":"/images/condition-thyroid.webp"},{"name":"Kidney Health & Function","description":"Early renal protection strategies, electrolyte balancing, and metabolic preservation.","image":"/images/condition-kidney.webp"},{"name":"Digestive & Gastrointestinal Care","description":"Clinical evaluation for acid reflux, microbiome health, and IBS management.","image":"/images/condition-digestive.webp"},{"name":"Autoimmune & Inflammatory Conditions","description":"Multisystem differential diagnosis and modern immune-modulating treatment plans.","image":"/images/condition-autoimmune.webp"}],"services":[{"title":"Comprehensive Health Checkups","description":"Thorough multi-organ baseline screening with integrated biometric risk calculations.","image":"/images/service-checkups.webp"},{"title":"Chronic Disease Management","description":"Synchronized care plans for hypertension, metabolic health, and medication reconciliation.","image":"/images/service-chronic-care.webp"},{"title":"Preventive Health Screening","description":"Advanced lipid subfractions, vascular calcium scoring, and cancer surveillance.","image":"/images/service-screening.webp"},{"title":"Diagnostic Consultations","description":"In-depth evaluations for complex symptoms, persistent fatigue, and second opinions.","image":"/images/service-diagnostic.webp"}],"stats":[{"value":"15+","label":"Years Avg Experience"},{"value":"98.4%","label":"Patient Satisfaction"},{"value":"Same-Week","label":"Consultation Access"},{"value":"100%","label":"Digital Health Records"}],"faqs":[{"question":"Can an internist act as my primary care doctor?","answer":"Yes, internists specialize in adult primary care, managing routine wellness as well as complex chronic health conditions."},{"question":"What should I bring to my first consultation?","answer":"Bring a list of current medications, prior diagnostic reports or lab results, and your medical history notes."}]}}],["$","$L25",null,{"specialtyId":"internal-medicine","subtitle":"Targeted diagnosis and ongoing management for acute and chronic adult health conditions.","conditions":"$10:props:children:1:props:specialty:conditions"}],["$","$L26",null,{"specialtyId":"internal-medicine","specialtyName":"Internal Medicine","services":"$10:props:children:1:props:specialty:services"}],["$","$L27",null,{"specialtyName":"Internal Medicine","doctors":[{"id":"dr-evelyn-vance","name":"Dr. Evelyn Vance, MD, FACP","title":"Lead Internist & Diagnostic Specialist","specialtyId":"internal-medicine","specialtyName":"Internal Medicine","image":"/images/doc-internal-dr-vance.webp","qualifications":["MD - Johns Hopkins University","Residency - Massachusetts General Hospital","Fellow, American College of Physicians"],"experienceYears":16,"availability":"Mon, Wed, Fri (In-Person & Telehealth)","rating":4.9,"reviewsCount":184,"languages":["English","French"],"hospitalAffiliation":"MedBridge Global Health Pavilion","consultationFee":"$$180","bio":"Dr. Evelyn Vance has over 16 years of clinical excellence in diagnostic internal medicine and chronic disease management. She focuses on complex multisystem conditions, preventative cardiovascular health, and personalized wellness roadmaps.","education":["MD, Johns Hopkins University School of Medicine","Internal Medicine Residency, Massachusetts General Hospital / Harvard Medical School","Board Certified, American Board of Internal Medicine"],"areasOfExpertise":["Diagnostic Dilemmas","Metabolic Syndrome","Hypertension","Preventive Longevity"]},{"id":"dr-julian-thorne","name":"Dr. Julian Thorne, MD","title":"Consultant Physician in Internal Medicine","specialtyId":"internal-medicine","specialtyName":"Internal Medicine","image":"/images/doc-internal-dr-thorne.webp","qualifications":["MD - Columbia University","Residency - NewYork-Presbyterian Hospital","Diplomate, American Board of Internal Medicine"],"experienceYears":12,"availability":"Tue, Thu, Sat (In-Person)","rating":4.8,"reviewsCount":142,"languages":["English","Spanish"],"hospitalAffiliation":"MedBridge Global Health Pavilion","consultationFee":"$$165","bio":"Dr. Julian Thorne provides empathetic and data-driven primary care for adults. His practice integrates continuous glucose monitoring, cardiovascular risk stratification, and patient-centered lifestyle medicine.","education":["MD, Columbia University Vagelos College of Physicians and Surgeons","Residency, NewYork-Presbyterian / Weill Cornell Medical Center","Board Certified, American Board of Internal Medicine"],"areasOfExpertise":["Preventive Health","Diabetes Management","Lipid Disorders","Adult Vaccinations"]},{"id":"dr-ananya-sharma","name":"Dr. Ananya Sharma, MD, FACP","title":"Senior Consultant in Internal Medicine","specialtyId":"internal-medicine","specialtyName":"Internal Medicine","image":"/images/indian-doctors/indian-doctor-01-female-internist.webp","qualifications":["MBBS - AIIMS New Delhi","MD - Internal Medicine, PGIMER","Fellow, American College of Physicians"],"experienceYears":16,"availability":"Mon, Wed, Fri (In-Person & Telehealth)","rating":4.96,"reviewsCount":215,"languages":["English","Hindi","Punjabi"],"hospitalAffiliation":"MedBridge Global Health Pavilion","consultationFee":"$$175","bio":"Dr. Ananya Sharma specializes in preventive adult health, complex metabolic disorders, and chronic disease coordination. With over 16 years of clinical practice, she champions patient-centered lifestyle therapeutics and evidence-led medicine.","education":["MBBS, All India Institute of Medical Sciences (AIIMS)","MD in Internal Medicine, PGIMER Chandigarh","Fellowship in Clinical Diagnostics, Johns Hopkins Medicine"],"areasOfExpertise":["Metabolic Health","Preventive Care","Diabetes Management","Hypertension"]},{"id":"dr-rajesh-verma","name":"Dr. Rajesh K. Verma, MD","title":"Senior Physician & Clinical Lead","specialtyId":"internal-medicine","specialtyName":"Internal Medicine","image":"/images/indian-doctors/indian-doctor-02-male-physician.webp","qualifications":["MBBS - Maulana Azad Medical College","MD - Internal Medicine","Diplomate, National Board (DNB)"],"experienceYears":19,"availability":"Tue, Thu, Sat (In-Person)","rating":4.92,"reviewsCount":280,"languages":["English","Hindi"],"hospitalAffiliation":"MedBridge Global Health Pavilion","consultationFee":"$$180","bio":"Dr. Rajesh K. Verma brings nearly two decades of senior inpatient and outpatient experience, specializing in multi-system diagnostic dilemmas, geriatrics, and cardiovascular risk reduction.","education":["MBBS, Maulana Azad Medical College (MAMC)","MD in Internal Medicine, Delhi University","Senior Residency, Safdarjung Hospital"],"areasOfExpertise":["Adult Geriatrics","Multi-System Disorders","Lipid Management","Infectious Diseases"]},{"id":"dr-harish-bhattacharya","name":"Dr. Harish Bhattacharya, MD, FRCP","title":"Chief of Medicine & Senior Clinical Director","specialtyId":"internal-medicine","specialtyName":"Internal Medicine","image":"/images/indian-doctors/indian-doctor-20-male-chief-of-medicine.webp","qualifications":["MBBS - Medical College Kolkata","MD - Internal Medicine, AIIMS","Fellow, Royal College of Physicians (FRCP London)"],"experienceYears":22,"availability":"Mon, Tue, Thu (In-Person & VIP Consultations)","rating":4.99,"reviewsCount":450,"languages":["English","Bengali","Hindi"],"hospitalAffiliation":"MedBridge Global Health Pavilion","consultationFee":"$$225","bio":"Dr. Harish Bhattacharya brings over two decades of distinguished clinical leadership. He oversees internal medicine departments, coordinating multispecialty panels for complex and unsolved medical diagnoses.","education":["MBBS, Medical College Kolkata (Estd. 1835)","MD Internal Medicine, AIIMS New Delhi","Senior Fellow, Royal College of Physicians London"],"areasOfExpertise":["Diagnostic Dilemmas","Cardiometabolic Syndrome","Clinical Leadership","Longevity Medicine"]}]}],"$L28","$L29","$L2a","$L2b"]}]
