10:["$","main",null,{"className":"min-h-screen bg-white text-[#080808] flex flex-col selection:bg-neutral-200","children":[["$","$L23",null,{}],["$","$L24",null,{"specialty":{"id":"family-medicine","name":"Family Medicine","label":"FAMILY MEDICINE","shortIntro":"Continuous, compassionate healthcare tailored for every generation of your family from infancy through mature adulthood.","heroImage":"/images/specialty-hero-family-medicine.webp","heroAlt":"Family doctor consulting with parents and child in a warm modern clinic","conditionsSubtitle":"Comprehensive medical care addressing acute needs and preventive health for all ages.","conditions":[{"name":"Acute Infections & Illnesses","description":"Rapid relief and diagnosis for fevers, respiratory infections, and seasonal bugs.","image":"/images/condition-digestive.webp"},{"name":"Child & Adolescent Development","description":"Pediatric growth charting, milestone reviews, and school athletic physicals.","image":"/images/condition-autoimmune.webp"},{"name":"Asthma & Environmental Allergies","description":"Trigger isolation, inhaler management, and long-term pulmonary support.","image":"/images/condition-cardio.webp"},{"name":"Joint Strains & Minor Injuries","description":"Orthopedic triage, sprain recovery, and safe rehabilitation protocols.","image":"/images/condition-kidney.webp"},{"name":"Routine Dermatological Care","description":"Skin wellness checkups, eczema therapy, and minor in-office cryotherapy.","image":"/images/condition-thyroid.webp"},{"name":"Healthy Aging & Geriatric Support","description":"Mobility preservation, memory wellness, and prescription safety reviews.","image":"/images/condition-diabetes.webp"}],"services":[{"title":"Well-Child & Family Physicals","description":"Full health assessments, developmental milestones, and age-graded immunizations.","image":"/images/service-checkups.webp"},{"title":"Rapid Sick-Visit Consultations","description":"Priority same-day appointment access for sudden symptoms, flu, and infections.","image":"/images/service-diagnostic.webp"},{"title":"Lifelong Preventive Screenings","description":"Family risk profiling, blood pressure monitoring, and coordinated cancer screenings.","image":"/images/service-screening.webp"},{"title":"Women's & Men's Health Care","description":"Dedicated wellness examinations, reproductive consultations, and hormone health.","image":"/images/service-chronic-care.webp"}],"stats":[{"value":"All Ages","label":"Care Coverage"},{"value":"99.1%","label":"Family Retention"},{"value":"< 24hr","label":"Urgent Access"},{"value":"4.95 / 5","label":"Average Rating"}],"faqs":[{"question":"Can my whole family visit the same physician?","answer":"Yes, family doctors are uniquely trained to care for infants, children, adults, and seniors under one coordinated roof."}]}}],["$","$L25",null,{"specialtyId":"family-medicine","subtitle":"Comprehensive medical care addressing acute needs and preventive health for all ages.","conditions":"$10:props:children:1:props:specialty:conditions"}],["$","$L26",null,{"specialtyId":"family-medicine","specialtyName":"Family Medicine","services":"$10:props:children:1:props:specialty:services"}],["$","$L27",null,{"specialtyName":"Family Medicine","doctors":[{"id":"dr-sofia-rivera","name":"Dr. Sofia Rivera, MD, FAAFP","title":"Director of Family & Community Medicine","specialtyId":"family-medicine","specialtyName":"Family Medicine","image":"/images/doc-family-dr-rivera.webp","qualifications":["MD - Stanford University School of Medicine","Residency - UCSF Family Medicine","Fellow, American Academy of Family Physicians"],"experienceYears":14,"availability":"Mon, Tue, Wed, Thu (In-Person & Telehealth)","rating":4.95,"reviewsCount":220,"languages":["English","Spanish","Portuguese"],"hospitalAffiliation":"MedBridge Family Health Center","consultationFee":"$$150","bio":"Dr. Sofia Rivera provides multi-generational healthcare, caring for patients from childhood through elder years. She believes in tr