Hindi","Marathi"],"hospitalAffiliation":"MedBridge Family Health Center","consultationFee":"$$150","bio":"Dr. Sunita Deshmukh provides continuous healthcare for patients of all age groups. Her clinical focus includes preventative wellness, childhood growth reviews, and lifestyle metabolic management.","education":["MBBS, B.J. Medical College Pune","MD Family Medicine, AIIMS New Delhi","Diploma in Child Health (DCH), Mumbai"],"areasOfExpertise":["Whole-Family Care","Well-Child Checks","Preventative Immunization","Hypertension Care"]},{"id":"dr-priya-nair","name":"Dr. Priya Nair, MD","title":"Consultant in Family & Adolescent Medicine","specialtyId":"family-medicine","specialtyName":"Family Medicine","image":"/images/indian-doctors/indian-doctor-03-female-consultant.webp","qualifications":["MBBS - Government Medical College Trivandrum","MD - General & Family Practice","Member, Royal College of Physicians"],"experienceYears":13,"availability":"Tue, Thu, Sat (In-Person)","rating":4.93,"reviewsCount":198,"languages":["English","Malayalam","Hindi"],"hospitalAffiliation":"MedBridge Family Health Center","consultationFee":"$$145","bio":"Dr. Priya Nair specializes in adolescent health, chronic disease screening, and family preventative medicine, delivering compassionate care with synchronized digital records.","education":["MBBS, Government Medical College Thiruvananthapuram","MD Family Practice, Post Graduate Institute of Medical Sciences","Certification in Adolescent Health, Royal College of Paediatrics"],"areasOfExpertise":["Adolescent Health","Preventative Screenings","Routine Vaccinations","Family Wellness"]}]}],"$L28","$L29","$L2a","$L2b"]}]
