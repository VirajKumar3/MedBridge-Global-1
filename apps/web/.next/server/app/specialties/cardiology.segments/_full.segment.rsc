10:["$","main",null,{"className":"min-h-screen bg-white text-[#080808] flex flex-col selection:bg-neutral-200","children":[["$","$L23",null,{}],["$","$L24",null,{"specialty":{"id":"cardiology","name":"Cardiology","label":"CARDIOLOGY","shortIntro":"Advanced cardiovascular evaluations, non-invasive imaging, and preventive vascular care for lifelong heart health.","heroImage":"/images/specialty-hero-cardiology.webp","heroAlt":"Cardiologist examining heart diagnostics and monitors in an advanced clinic","conditionsSubtitle":"Specialized clinical diagnosis and therapy for coronary, rhythm, and vascular conditions.","conditions":[{"name":"Coronary Artery Health","description":"Early plaque detection, ischemia evaluation, and preventive arterial therapy.","image":"/images/condition-cardio.webp"},{"name":"Heart Rhythm & Arrhythmias","description":"Atrial fibrillation management, ambulatory patch monitoring, and stroke prevention.","image":"/images/condition-diabetes.webp"},{"name":"Hypertension & Vascular Strain","description":"Endothelial function analysis and tailored multi-agent blood pressure regimens.","image":"/images/condition-kidney.webp"},{"name":"Heart Failure & Cardiomyopathy","description":"Neurohormonal therapy, ejection fraction monitoring, and symptom control.","image":"/images/condition-thyroid.webp"},{"name":"Valvular Heart Conditions","description":"Echocardiographic monitoring for aortic stenosis, mitral regurgitation, and repairs.","image":"/images/condition-autoimmune.webp"},{"name":"Preventive Lipid Disorders","description":"Advanced ApoB and Lp(a) analysis to stop atherosclerosis before events happen.","image":"/images/condition-digestive.webp"}],"services":[{"title":"High-Resolution Echocardiography","description":"Clear ultrasound visualization of heart chambers, blood flow, and valve dynamics.","image":"/images/service-diagnostic.webp"},{"title":"Cardiopulmonary Stress Testing","description":"Treadmill and pharmacologic stress evaluations for coronary flow and stamina.","image":"/images/service-checkups.webp"},{"title":"Continuous Digital Holter Tracking","description":"Extended wireless patch monitors tracking intermittent palpitations and arrhythmias.","image":"/images/service-screening.webp"},{"title":"Preventive Cardiometabolic Care","description":"Personalized arterial wellness roadmaps, lifestyle optimization, and statin management.","image":"/images/service-chronic-care.webp"}],"stats":[{"value":"24-48h","label":"ECG Turnaround"},{"value":"99.4%","label":"Diagnostic Accuracy"},{"value":"5,000+","label":"Echo Studies Reviewed"},{"value":"Top 1%","label":"Cardiology Specialists"}],"faqs":[{"question":"When should I consult a cardiologist?","answer":"If you experience chest tightness, shortness of breath, unexplained palpitations, dizziness, or have a family history of early heart disease."}]}}],["$","$L25",null,{"specialtyId":"cardiology","subtitle":"Specialized clinical diagnosis and therapy for coronary, rhythm, and vascular conditions.","conditions":"$10:props:children:1:props:specialty:conditions"}],["$","$L26",null,{"specialtyId":"cardiology","specialtyName":"Cardiology","services":"$10:props:children:1:props:specialty:services"}],["$","$L27",null,{"specialtyName":"Cardiology","doctors":[{"id":"dr-marcus-chen","name":"Dr. Marcus Chen, MD, FACC","title":"Chief of Cardiovascular Medicine","specialtyId":"cardiology","specialtyName":"Cardiology","image":"/images/doc-cardio-dr-chen.webp","qualifications":["MD - Harvard Medical School","Fellowship - Brigham and Women's Hospital","Fellow, American College of Cardiology"],"experienceYears":18,"availability":"Mon, Wed, Thu (In-Person)","rating":4.98,"reviewsCount":310,"languages":["English","Mandarin"],"hospitalAffiliation":"MedBridge Heart & Vascular Institute","consultationFee":"$$220","bio":"Dr. Marcus Chen is an internationally recognized cardiologist specializing in preventative cardiology, coronary plaque evaluation, and cardiac imaging. He is passionate about halting atherosclerosis through personalized lifestyle and pharmacotherapy.","education":["MD, Harvard Medical School","Internal Medicine Residency, Brigham and Women's Hospital","Cardiovascular Disease Fellowship, Brigham and Women's Hospital","Board Certified, Cardiovascular Disease & Echocardiography"],"areasOfExpertise":["Coronary Artery Disease","Echocardiography","Preventative Lipids","Heart Failure"]},{"id":"dr-rachel-adams","name":"Dr. Rachel Adams, MD","title":"Consultant Cardiologist & Heart Rhythm Specialist","specialtyId":"cardiology","specialtyName":"Cardiology","image":"/images/doc-cardio-dr-adams.webp","qualifications":["MD - Penn Medicine","Fellowship - Cleveland Clinic Cardiology","Board Certified in Cardiovascular Disease"],"experienceYears":11,"availability":"Tue, Thu, Fri (In-Person & Telehealth)","rating":4.9,"reviewsCount":168,"languages":["English"],"hospitalAffiliation":"MedBridge Heart & Vascular Institute","consultationFee":"$$200","bio":"Dr. Rachel Adams specializes in cardiac arrhythmias, atrial fibrillation management, and syncope evaluations. She utilizes modern ambulatory patch monitors to accurately diagnose intermittent palpitations and fainting spells.","education":["MD, Perelman School of Medicine at University of Pennsylvania","Internal Medicine Residency, Hospital of the University of Pennsylvania","Cardiovascular Fellowship, Cleveland Clinic","Board Certified, Cardiovascular Disease"],"areasOfExpertise":["Atrial Fibrillation","Arrhythmia Monitoring","Palpitation Workup","Vascular Wellness"]},{"id":"dr-vikram-patel","name":"Dr. Vikram Patel, MD, DM, FACC","title":"Consultant Interventional Cardiologist","specialtyId":"cardiology","specialtyName":"Cardiology","image":"/images/indian-doctors/indian-doctor-04-male-cardiologist.webp","qualifications":["MBBS - Seth GS Medical College","DM - Cardiology, KEM Hospital","Fellow, American College of Cardiology"],"experienceYears":17,"availability":"Mon, Tue, Thu (In-Person)","rati