10:["$","main",null,{"className":"min-h-screen bg-white text-[#080808] flex flex-col selection:bg-neutral-200","children":[["$","$L23",null,{}],["$","$L24",null,{"specialty":{"id":"dermatology","name":"Dermatology","label":"DERMATOLOGY","shortIntro":"Expert medical and surgical dermatology safeguarding skin health through precision dermoscopy and tailored therapies.","heroImage":"/images/specialty-hero-dermatology.webp","heroAlt":"Dermatologist examining a patient's skin with advanced dermascope in a serene clinic","conditionsSubtitle":"Clinical evaluations and modern dermatologic therapies for healthy, resilient skin.","conditions":[{"name":"Skin Cancer & Atypical Moles","description":"High-magnification polarized dermoscopy, mole mapping, and early melanoma screening.","image":"/images/condition-thyroid.webp"},{"name":"Severe Adult & Teen Acne","description":"Targeted topical regimens, hormonal therapies, and barrier-safe treatments.","image":"/images/condition-diabetes.webp"},{"name":"Eczema & Atopic Dermatitis","description":"Barrier repair protocols, modern biologics, and non-steroidal topical therapies.","image":"/images/condition-autoimmune.webp"},{"name":"Psoriasis & Scalp Care","description":"Systemic immunomodulators, phototherapy coordination, and scalp relief.","image":"/images/condition-digestive.webp"},{"name":"Hair Loss & Scalp Disorders","description":"Trichoscopic scalp imaging, hormone panels, and regenerative hair solutions.","image":"/images/condition-cardio.webp"},{"name":"Allergic Contact Rashes","description":"Hypoallergenic patch testing, barrier restoration, and soothing treatments.","image":"/images/condition-kidney.webp"}],"services":[{"title":"Full-Body Digital Skin Screenings","description":"High-definition dermoscopic documentation tracking mole changes over time.","image":"/images/service-screening.webp"},{"title":"Precision In-Office Skin Biopsies","description":"Minimally scarring shave and punch biopsies with prompt pathology turnaround.","image":"/images/service-diagnostic.webp"},{"title":"Advanced Biologic Infusions","description":"Targeted molecular therapies for refractory psoriasis, eczema, and urticaria.","image":"/images/service-chronic-care.webp"},{"title":"Medical Barrier Rehabilitation","description":"Customized dermatologic formulations tailored to individual skin microclimates.","image":"/images/service-checkups.webp"}],"stats":[{"value":"10,000+","label":"Exams Completed"},{"value":"Same-Day","label":"Pathology Submission"},{"value":"4.97 / 5","label":"Patient Rating"},{"value":"Top Tier","label":"Board Certification"}],"faqs":[{"question":"How often should I get a full skin check?","answer":"We recommend an annual full-body skin exam, or sooner if you notice changes in size, shape, or color of any mole."}]}}],["$","$L25",null,{"specialtyId":"dermatology","subtitle":"Clinical evaluations and modern dermatologic therapies for healthy, resilient skin.","conditions":"$10:props:children:1:props:specialty:conditions"}],["$","$L26",null,{"specialtyId":"dermatology","specialtyName":"Dermatology","services":"$10:props:children:1:props:specialty:services"}],["$","$L27",null,{"specialtyName":"Dermatology","doctors":[{"id":"dr-maya-zheng","name":"Dr. Maya Zheng, MD, FAAD","title":"Director of Clinical & Surgical Dermatology","specialtyId":"dermatology","specialtyName":"Dermatology","image":"/images/doc-derma-dr-zheng.webp","qualifications":["MD - Stanford University School of Medicine","Residency - Harvard Dermatology","Fellow, American Academy of Dermatology"],"experienceYears":15,"availability":"Mon, Tue, Thu (In-Person)","rating":4.97,"reviewsCount":340,"languages":["English","Mandarin"],"hospitalAffiliation":"MedBridge Skin & Wellness Pavilion","consultationFee":"$$195","bio":"Dr. Maya Zheng is an esteemed dermatologist with extensive experience in early skin cancer detection, dermoscopic lesion mapping, acne protocols, and biologic therapies for severe psoriasis and eczema.","education":["MD, Stanford University School of Medicine","Dermatology Residency, Harvard Combined Dermatology Program","Board Certified, American Board of Dermatology"],"areasOfExpertise":["Dermoscopy & Mole Mapping","Skin Cancer Excision","Biologic Therapies","Severe Adult Acne"]},{"id":"dr-ritu-agarwal","name":"Dr. Ritu Agarwal, MD, DVD","title":"Consultant Dermatologist & Dermatosurgeon","specialtyId":"dermatology","specialtyName":"Dermatology","image":"/images/indian-doctors/indian-doctor-17-female-dermatologist.webp","qualifications":["MBBS - Bangalore Medical College","MD - Dermatology, Venereology & Leprosy","Fellow, International Society of Dermatology"],"experienceYears":14,"availability":"Mon, Wed, Fri (In-Person)","rating":4.98,"reviewsCount":380,"languages":["English","Hindi","Kannada"],"hospitalAffiliation":"MedBridge Skin & Wellness Pavilion","consultationFee":"$$185","bio":"Dr. Ritu Agarwal is an accomplished clinical dermatologist specializing in early skin cancer screening via polarized dermoscopy, modern biologic therapies for severe psoriasis, and medical acne recovery programs.","education":["MBBS, Bangalore Medical College and Research Institute","MD Dermatology, Post Graduate Institute of Medical Education & Research","Fellowship in Dermatologic Surgery, Singapore"],"areasOfExpertise":["Dermoscopy & Mole Mapping","Biologic Therapies","Severe Adult Acne","Barrier Restoration"]},{"id":"dr-shalini-bose","name":"Dr. Shalini Bose, MD, DNB","title":"Consultant Dermatologist & Dermatosurgeon","specialtyId":"dermatology","specialtyName":"Dermatology","image":"/images/indian-doctors/indian-doctor-19-female-oncologist.webp","qualifications":["MBBS - Medical College Kolkata","MD - Dermatology, AIIMS","DNB Dermatology"],"experienceYears":15,"availability":"Tue, Thu, Sat (In-Person & Telehealth)","rating":4.96,"reviewsCount":320,"languages":["English","Bengali","Hindi"],"hospitalAffiliation":"MedBridge Skin & Wellness Pavilion","consultationFee":"$$190","bio":"Dr. Shalini Bose has over 15 years of expertise in full-body dermoscopy, skin barrier repair, and procedural dermatology for benign and atypical lesions.","education":["MBBS, Medical College Kolkata","MD Dermatology & Venereology, AIIMS New Delhi","Fellowship in Dermatologic Oncology & Dermoscopy, London"],"areasOfExpertise":["Dermoscopy & Mole Reviews","Skin Barrier Protocols","Biologic Therapies","Procedural Dermatology"]}]}],"$L28","$L29","$L2a","$L2b"]}]
